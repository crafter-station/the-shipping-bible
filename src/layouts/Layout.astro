---
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = 'The Shipping Bible | Crafter Station',
	description = 'The Crafter Station Shipping Playbook. We ship. We build in public. We learn by doing.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		<title>{title}</title>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-yellow: #F7DF1E;
		--color-black: #000000;
		--color-white: #FFFFFF;
		--color-gray-100: #F5F5F5;
		--color-gray-200: #E5E5E5;
		--color-gray-300: #D4D4D4;
		--color-gray-400: #A3A3A3;
		--color-gray-500: #737373;
		--color-gray-600: #525252;
		--color-gray-700: #404040;
		--color-gray-800: #262626;
		--color-gray-900: #171717;

		--bg: var(--color-white);
		--bg-alt: var(--color-gray-100);
		--text: var(--color-gray-600);
		--text-muted: var(--color-gray-400);
		--accent: var(--color-yellow);
		--border: var(--color-black);
	}

	html.dark {
		--bg: var(--color-black);
		--bg-alt: var(--color-gray-900);
		--text: var(--color-gray-400);
		--text-muted: var(--color-gray-500);
		--accent: var(--color-yellow);
		--border: var(--color-yellow);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: 'Libre Baskerville', Georgia, 'Times New Roman', serif;
		font-weight: 400;
		font-size: 16px;
		line-height: 1.6;
		background-color: var(--bg);
		color: var(--text);
		scroll-behavior: smooth;
	}

	body {
		min-height: 100vh;
		background-color: var(--bg);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	::selection {
		background-color: var(--accent);
		color: var(--color-black);
	}

	a {
		color: var(--accent);
		text-decoration: none;
		border-bottom: 1px solid var(--accent);
	}

	a:hover {
		background-color: var(--accent);
		color: var(--color-black);
	}

	h1, h2, h3, h4, h5, h6 {
		font-weight: 400;
		line-height: 1.2;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	h1 {
		font-size: 2rem;
		border-bottom: 3px solid var(--border);
		padding-bottom: 0.5rem;
	}

	h2 {
		font-size: 1.5rem;
		border-bottom: 2px solid var(--border);
		padding-bottom: 0.25rem;
	}

	h3 {
		font-size: 1.25rem;
	}

	h4 {
		font-size: 1.1rem;
	}

	p {
		margin-bottom: 1rem;
	}

	ul, ol {
		margin-bottom: 1rem;
		padding-left: 1.5rem;
	}

	li {
		margin-bottom: 0.5rem;
	}

	li::marker {
		color: var(--accent);
	}

	blockquote {
		border-left: 4px solid var(--accent);
		padding-left: 1rem;
		margin: 1.5rem 0;
		font-style: italic;
		background-color: var(--bg-alt);
		padding: 1rem;
	}

	code {
		font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', 'Source Code Pro', 'Courier New', monospace;
		font-size: 0.9em;
		background-color: var(--bg-alt);
		padding: 0.125rem 0.25rem;
		border: 1px solid var(--border);
	}

	pre {
		background-color: var(--bg-alt);
		border: 2px solid var(--border);
		padding: 1rem;
		overflow-x: auto;
		margin: 1.5rem 0;
	}

	pre code {
		background: none;
		border: none;
		padding: 0;
	}

	hr {
		border: none;
		border-top: 2px solid var(--border);
		margin: 2rem 0;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
	}

	th, td {
		border: 2px solid var(--border);
		padding: 0.75rem;
		text-align: left;
	}

	th {
		background-color: var(--accent);
		color: var(--color-black);
		font-weight: 400;
	}

	tr:nth-child(even) {
		background-color: var(--bg-alt);
	}

	strong, b {
		font-weight: 700;
	}

	/* Checkbox styling for task lists */
	input[type="checkbox"] {
		appearance: none;
		width: 1rem;
		height: 1rem;
		border: 2px solid var(--border);
		margin-right: 0.5rem;
		vertical-align: middle;
		cursor: pointer;
	}

	input[type="checkbox"]:checked {
		background-color: var(--accent);
	}

	/* Responsive */
	@media (max-width: 768px) {
		html {
			font-size: 14px;
		}

		h1 {
			font-size: 1.75rem;
		}

		h2 {
			font-size: 1.35rem;
		}

		h3 {
			font-size: 1.15rem;
		}

		table {
			font-size: 0.85rem;
		}

		th, td {
			padding: 0.5rem;
		}
	}

	@media (max-width: 480px) {
		html {
			font-size: 13px;
		}

		pre {
			padding: 0.75rem;
		}
	}
</style>
